# Optional: where the Python service and its virtualenv live.
# ANTIGRAVITY_SDK_HOME=C:\path\to\AntigravitySDK

# Optional: override the interpreter that runs the dashboard service.
# ANTIGRAVITY_PYTHONW=C:\path\to\pythonw.exe

# Optional: dashboard service port (default 8765).
# ANTIGRAVITY_DASHBOARD_PORT=8765
